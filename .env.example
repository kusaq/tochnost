# Камера дашборда (отдельно от collect_Data/.env — скопируйте HIKVISION_* сюда)
CAMERA_ENABLED=true
CAMERA_MOCK=false
CAMERA_CAPTURE_MODE=http
CAMERA_CAPTURE_INTERVAL_SEC=2
CAMERA_MOTION_THRESHOLD=8.0

HIKVISION_USER=admin
HIKVISION_PASS=your_password
HIKVISION_FRONT_IP=192.168.1.107
HIKVISION_FRONT_CHANNEL=101

# Telegram: 20 фото/сек при уходе РШР с поста 2 (та же камера, что на дашборде)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-5021626912
TELEGRAM_RAIL_BURST_COUNT=20
TELEGRAM_RAIL_BURST_INTERVAL_SEC=1

# HTTP snapshot (режим по умолчанию)
HIKVISION_HTTP_PORT=80
HIKVISION_HTTP_USE_HTTPS=false
HIKVISION_HTTP_TIMEOUT_SEC=10
# HIKVISION_HTTP_SNAPSHOT_PATH=/ISAPI/Streaming/channels/101/picture

# RTSP (только если CAMERA_CAPTURE_MODE=rtsp)
HIKVISION_RTSP_PORT=554
HIKVISION_RTSP_TRANSPORT=tcp

HIKVISION_CROP_TOP=0
HIKVISION_CROP_BOTTOM=0
HIKVISION_CROP_LEFT=0
HIKVISION_CROP_RIGHT=0
HIKVISION_JPEG_QUALITY=75

# Stream Monitor: РАЗДЕЛЬНЫЕ буферы событий.
# STREAM_MONITOR_MAX_EVENTS — сырой firehose (sensor_raw + всё, для live/mode=full).
# STREAM_MONITOR_MAX_PIPELINE_EVENTS — durable-буфер ТОЛЬКО pipeline-событий
# (rshr_opened → … → rshr_closed). Сырой Modbus/Sensor1 его НЕ вытесняет, поэтому
# export?mode=pipeline и incident отдают полную историю конвейера. Поднимайте, если
# нужна история за более долгий период активной закрутки.
STREAM_MONITOR_MAX_EVENTS=5000
STREAM_MONITOR_MAX_PIPELINE_EVENTS=20000
