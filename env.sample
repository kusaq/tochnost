# =============================================================================
# Конфигурация приложения RZhD Data Service
# =============================================================================
# Скопируйте этот файл в .env и заполните своими значениями
# cp env.sample .env

# =============================================================================
# API / Аутентификация
# =============================================================================
# Секретный ключ для подписи JWT токенов (ОБЯЗАТЕЛЬНО измените в продакшене!)
API_SECRET_KEY=change-me

# Алгоритм для JWT токенов (обычно не нужно менять)
API_TOKEN_ALGORITHM=HS256

# Время жизни токена в минутах
API_TOKEN_TTL_MIN=60

# Имя пользователя для входа в API
API_USERNAME=admin

# Пароль в открытом виде (только для разработки!)
# В продакшене используйте API_PASSWORD_HASH
API_PASSWORD=supersecret

# Опционально: хеш пароля bcrypt (приоритет над API_PASSWORD)
# Для генерации: python -c "from passlib.context import CryptContext; ctx = CryptContext(schemes=['bcrypt']); print(ctx.hash('your_password'))"
# API_PASSWORD_HASH=$2b$12$example...

# =============================================================================
# Хранилище данных
# =============================================================================
# Базовая директория для сохранения захваченных изображений
DATA_ROOT=data

# =============================================================================
# Камеры Hikvision
# =============================================================================
# Учетные данные для доступа к камерам
HIKVISION_USER=admin
HIKVISION_PASS=password

# IP адреса камер
HIKVISION_TOP_IP=192.168.1.104
HIKVISION_FRONT_IP=192.168.1.105

# Порт RTSP
HIKVISION_RTSP_PORT=554

# Номера каналов
HIKVISION_TOP_CHANNEL=101
HIKVISION_FRONT_CHANNEL=101

# Дополнительные настройки захвата
# Интервал захвата кадров в секундах
HIKVISION_CAPTURE_INTERVAL=3

# Длительность захвата в минутах
HIKVISION_CAPTURE_DURATION_MIN=90

# Показывать превью при захвате (false/true или 0/1)
HIKVISION_PREVIEW=false

# Обрезка изображений (в пикселях)
HIKVISION_CROP_TOP=0
HIKVISION_CROP_BOTTOM=0
HIKVISION_CROP_LEFT=0
HIKVISION_CROP_RIGHT=0

# Качество JPEG (10-100)
HIKVISION_JPEG_QUALITY=85

# Архивация
# Создавать архив после захвата (false/true или 0/1)
HIKVISION_ARCHIVE_AFTER_CAPTURE=true

# Удалять оригиналы после архивации (false/true или 0/1)
HIKVISION_ARCHIVE_REMOVE_ORIGINALS=false

# =============================================================================
# Modbus преобразователь
# =============================================================================
# IP адрес и порт Modbus устройства
MODBUS_IP=192.168.1.106
MODBUS_PORT=502

# Unit ID Modbus устройства
MODBUS_UNIT_ID=1

# Таймаут подключения в секундах
MODBUS_TIMEOUT=3.0

# Интервал опроса Modbus во время активного сбора данных (секунды)
MODBUS_POLL_INTERVAL_SEC=1.0

# Интервал опроса Modbus для обнаружения движения решетки (секунды)
MODBUS_DETECTION_INTERVAL_SEC=15.0

# Включить автоматический опрос Modbus при старте приложения
MODBUS_POLL_ENABLED=true

# =============================================================================
# База данных
# =============================================================================
# Строка подключения к PostgreSQL
# Формат: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rzd

# =============================================================================
# Дополнительные настройки (опционально)
# =============================================================================
# Заголовок API (отображается в документации Swagger/OpenAPI)
# Если не указано, используется значение по умолчанию: "RZhD Data Service"
# API_TITLE=RZhD Data Service

# Версия API (отображается в документации)
# Если не указано, используется значение по умолчанию: "1.0.0"
# API_VERSION=1.0.0

